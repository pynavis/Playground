<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Focusable="True">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- No colours here: script.py paints the paper, rows and hairlines from the
       pyNavis design system tokens, which follow the Navisworks theme. The
       toolbar buttons are DesignSystem quiet buttons added by the script. -->
  <WrapPanel x:Name="Toolbar" Grid.Row="0" Margin="8,8,4,4"/>

  <Border x:Name="Rule" Grid.Row="1" Height="1"/>

  <ScrollViewer x:Name="Scroller" Grid.Row="2" Focusable="False"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Rows"/>
  </ScrollViewer>

  <TextBlock x:Name="Status" Grid.Row="3" Margin="12,6,12,8" FontSize="11.5"
             TextWrapping="Wrap" Text=""/>
</Grid>
